{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trend TV",
  "version": "0.6.2",
  "identifier": "dev.trendtv.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7100"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Trend TV",
        "width": 480,
        "height": 380,
        "minWidth": 360,
        "minHeight": 300,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
